# Required: the local hostname or IP address of your own K2.
K2_HOST=YOUR_PRINTER_HOST

# Optional Moonraker port. Creality K2 installations commonly expose 7125.
K2_PORT=7125

# Keep writes disabled until read-only checks work.
K2_ALLOW_WRITE=0

# Optional local integrations. Set only on your own computer.
# K2_CLI=PATH_TO_CRELAITY_PRINT_EXECUTABLE
# K2_PROFILES=PATH_TO_CRELAITY_PROFILE_DIRECTORY
